# Supported values: ocr_only | vlm_only | ocr_vlm
EVENTS_DIARY_UNDERSTANDING_MODE=ocr_vlm

EVENTS_DIARY_VLM_PROVIDER=gemini
EVENTS_DIARY_VLM_API_KEY=<YOUR_GEMINI_API_KEY>
EVENTS_DIARY_VLM_API_BASE_URL=https://generativelanguage.googleapis.com
EVENTS_DIARY_VLM_API_VERSION=v1beta

EVENTS_DIARY_VLM_MODEL=gemini-flash-latest

EVENTS_DIARY_VLM_REQUEST_TIMEOUT_S=180
EVENTS_DIARY_VLM_MAX_ATTEMPTS=3
EVENTS_DIARY_VLM_RETRY_BASE_DELAY_S=5
EVENTS_DIARY_VLM_RETRY_MAX_DELAY_S=60
EVENTS_DIARY_VLM_RETRY_JITTER_S=1
